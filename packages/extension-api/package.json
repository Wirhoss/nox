{
  "name": "@nox/extension-api",
  "version": "0.1.0",
  "description": "Stable contracts and runtime primitives for Nox extensions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "nanoid": "^6.0.1",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false
}
