---
import Icon from './Icon.astro';
interface Props { title: string; }
const { title } = Astro.props;
---

<header class="topbar">
	<div class="topbar-location">
		<button class="icon-button nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-open><span></span><span></span><span></span></button>
		<span class="topbar-product">Nox</span><span class="topbar-divider">/</span><strong>{title}</strong>
	</div>
	<div class="topbar-actions">
		<button class="search-trigger" type="button" disabled title="Command search is planned"><Icon name="search" size={16} /><span>Search</span><kbd>⌘ K</kbd></button>
		<button class="activity-trigger" type="button" disabled title="Run activity is not available yet"><Icon name="activity" size={16} /><span>No active runs</span></button>
		<div class="local-badge"><span></span> Local workspace</div>
	</div>
</header>
