{
  "name": "nox",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:ui": "bun run --cwd ui check",
    "typecheck": "bun run typecheck:backend && bun run typecheck:ui",
    "test:backend": "bun test ./src",
    "test:ui": "bun run --cwd ui test",
    "test": "bun run test:backend && bun run test:ui",
    "lint": "eslint .",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "bundle:backend": "bun build index.ts --outdir dist --target bun && bun run scripts/syncMigrations.ts",
    "bundle:ui": "bun run --cwd ui build",
    "bundle": "bun run bundle:ui && bun run bundle:backend",
    "build": "bun run verify && bun run bundle",
    "build:all": "bun run build",
    "start:all": "bun run build && bun dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/pino": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.6.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "elysia-helmet": "^3.1.0",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typeorm": "1.1.0",
    "zod": "^4.4.3"
  }
}
