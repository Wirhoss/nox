---
import Sidebar from '../components/shell/Sidebar.astro';
import Topbar from '../components/shell/Topbar.astro';
import AsciiField from '../components/shell/AsciiField.astro';
import '../styles/index.css';

interface Props {
	title: string;
	activePath: string;
	contentClass?: string;
}

const { title, activePath, contentClass } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Nox is a local-first workbench for building and operating AI agents." />
		<meta name="theme-color" content="#0c0f0d" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title} · Nox Workbench</title>
	</head>
	<body>
		<div class="app-shell" data-shell>
			<AsciiField />
			<Sidebar activePath={activePath} />
			<div class="app-frame">
				<Topbar title={title} />
				<main class:list={['app-content', contentClass]} id="main-content"><slot /></main>
			</div>
			<button class="sidebar-scrim" type="button" aria-label="Close navigation" data-nav-close></button>
		</div>

		<script>
			const shell = document.querySelector<HTMLElement>('[data-shell]');
			const openButton = document.querySelector<HTMLButtonElement>('[data-nav-open]');
			const closeTargets = document.querySelectorAll<HTMLElement>('[data-nav-close]');
			const setNavigation = (open: boolean) => {
				shell?.toggleAttribute('data-nav-visible', open);
				openButton?.setAttribute('aria-expanded', String(open));
			};
			openButton?.addEventListener('click', () => setNavigation(true));
			closeTargets.forEach((target) => target.addEventListener('click', () => setNavigation(false)));
			window.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setNavigation(false);
			});
		</script>

		<style>
			/* Frame geometry. The sidebar and topbar style themselves; this file
			   owns only the space they sit in. */
			.app-shell {
				position: relative;
				min-height: 100vh;
				isolation: isolate;
			}
			.app-frame {
				position: relative;
				z-index: 1;
				min-height: 100vh;
				margin-left: var(--sidebar-width);
			}
			.app-content {
				width: 100%;
				max-width: 1520px;
				margin: 0 auto;
				padding: 30px 32px 48px;
			}

			/* The playground opts out of the centred column and runs full bleed.
			   --playground-gutter inherits down to the playground itself, which
			   reads it to size its viewport-height calculation. */
			.app-content.playground-content {
				--playground-gutter: clamp(10px, 2.5vmin, 24px);
				max-width: none;
				padding: var(--playground-gutter);
			}

			/* Tap-to-close backdrop, only present once the sidebar overlays. */
			.sidebar-scrim { display: none; }

			@media (max-width: 900px) {
				.app-frame { margin-left: 0; }
				.app-content { padding: 25px 22px 40px; }
				.sidebar-scrim {
					position: fixed;
					inset: 0;
					z-index: 25;
					display: block;
					visibility: hidden;
					background: rgb(0 0 0 / 55%);
					border: 0;
					opacity: 0;
					transition: opacity 180ms ease, visibility 180ms;
				}
				.app-shell[data-nav-visible] .sidebar-scrim {
					visibility: visible;
					opacity: 1;
				}
			}

			@media (max-width: 620px) {
				.app-content { padding: 22px 14px 32px; }
			}
		</style>
	</body>
</html>
