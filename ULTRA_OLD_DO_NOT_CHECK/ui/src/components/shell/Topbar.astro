---
import Icon from './Icon.astro';
interface Props { title: string; }
const { title } = Astro.props;
---

<header class="topbar">
	<div class="topbar-location">
		<button class="icon-button nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-open><span></span><span></span><span></span></button>
		<span class="topbar-product">Nox</span><span class="topbar-divider">/</span><strong>{title}</strong>
	</div>
	<div class="topbar-actions">
		<button class="search-trigger" type="button" disabled title="Command search is planned"><Icon name="search" size={16} /><span>Search</span><kbd>⌘ K</kbd></button>
		<button class="activity-trigger" type="button" disabled title="Run activity is not available yet"><Icon name="activity" size={16} /><span>No active runs</span></button>
	</div>
</header>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		height: var(--topbar-height);
		align-items: center;
		justify-content: space-between;
		padding: 0 24px;
		background: rgb(12 15 13 / 82%);
		border-bottom: 1px solid var(--border);
		backdrop-filter: blur(18px);
	}

	.topbar-location,
	.topbar-actions {
		display: flex;
		align-items: center;
	}
	.topbar-location {
		gap: 8px;
		font-size: 13px;
	}
	.topbar-location strong { font-weight: 580; }
	.topbar-product,
	.topbar-divider { color: var(--muted); }
	.topbar-actions { gap: 8px; }

	/* Placeholders for features that aren't wired up yet — both are disabled
	   and dimmed rather than hidden, so the shape of the bar stays stable. */
	.search-trigger,
	.activity-trigger {
		display: flex;
		height: 32px;
		align-items: center;
		gap: 8px;
		padding: 0 10px;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--secondary);
		font-size: 12px;
		cursor: default;
		opacity: .74;
	}
	.search-trigger kbd {
		padding: 1px 5px;
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--muted);
		font-family: inherit;
		font-size: 10px;
	}

	/* Hamburger, shown only once the sidebar goes off-canvas. */
	.nav-toggle { display: none; }

	@media (max-width: 900px) {
		.topbar { padding: 0 18px; }
		.nav-toggle {
			display: flex;
			width: 32px;
			height: 32px;
			align-items: center;
			justify-content: center;
			gap: 3px;
			flex-direction: column;
			background: transparent;
			border: 1px solid var(--border);
			border-radius: 6px;
		}
		.nav-toggle span {
			width: 13px;
			border-top: 1px solid var(--secondary);
		}
		/* Search collapses to its icon; activity drops out entirely. */
		.search-trigger {
			width: 32px;
			justify-content: center;
			padding: 0;
		}
		.search-trigger span,
		.search-trigger kbd,
		.activity-trigger { display: none; }
	}

	@media (max-width: 620px) {
		.topbar-product,
		.topbar-divider { display: none; }
	}
</style>
