<canvas class="ascii-field" data-ascii-field aria-hidden="true"></canvas>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('[data-ascii-field]');
	const context = canvas?.getContext('2d');

	if (canvas && context) {
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
		const characters = ['.', '·', ':', '+', '*', '=', '~', '#'];
		const frameInterval = 1000 / 12;
		let animationFrame = 0;
		let previousFrame = 0;

		const hash = (x: number, y: number) => {
			const value = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
			return value - Math.floor(value);
		};

		const resize = () => {
			const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
			canvas.width = Math.round(window.innerWidth * pixelRatio);
			canvas.height = Math.round(window.innerHeight * pixelRatio);
			context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
		};

		const draw = (time: number) => {
			const width = window.innerWidth;
			const height = window.innerHeight;
			const stepX = width < 700 ? 14 : 13;
			const stepY = 17;
			const phase = time * 0.001;

			context.clearRect(0, 0, width, height);
			context.font = '10px "SFMono-Regular", Consolas, monospace';
			context.textAlign = 'center';
			context.textBaseline = 'middle';

			for (let y = stepY / 2, row = 0; y < height; y += stepY, row += 1) {
				for (let x = stepX / 2, column = 0; x < width; x += stepX, column += 1) {
					const flow =
						Math.sin(column * 0.16 + phase * 0.22 + Math.sin(row * 0.19 - phase * 0.12) * 1.8) +
						Math.cos(row * 0.21 - phase * 0.17 + Math.sin(column * 0.11 + phase * 0.09) * 1.5);
					const ripple = Math.sin(Math.hypot(column - width / stepX * 0.76, row - height / stepY * 0.2) * 0.24 - phase * 0.28);
					const value = (flow + ripple * 0.55 + 2.55) / 5.1;
					const grain = hash(column, row);

					if (value < 0.38 + grain * 0.2) continue;

					const characterIndex = Math.min(characters.length - 1, Math.floor(value * characters.length));
					const alpha = 0.14 + value * 0.38;
					context.fillStyle = value > 0.68
						? `rgb(208 164 92 / ${alpha})`
						: `rgb(105 180 134 / ${alpha * 0.72})`;
					context.fillText(characters[characterIndex], x, y);
				}
			}
		};

		const animate = (timestamp: number) => {
			if (timestamp - previousFrame >= frameInterval) {
				draw(timestamp);
				previousFrame = timestamp;
			}
			animationFrame = window.requestAnimationFrame(animate);
		};

		const setMotion = () => {
			window.cancelAnimationFrame(animationFrame);
			if (motionPreference.matches) {
				draw(2400);
				return;
			}
			previousFrame = 0;
			animationFrame = window.requestAnimationFrame(animate);
		};

		resize();
		setMotion();
		window.addEventListener('resize', () => {
			resize();
			if (motionPreference.matches) draw(2400);
		});
		motionPreference.addEventListener('change', setMotion);
	}
</script>

<style>
	.ascii-field {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0.34;
		mix-blend-mode: screen;
		-webkit-mask-image: radial-gradient(ellipse 88% 82% at 82% 14%, #000 0%, rgb(0 0 0 / 78%) 43%, transparent 78%);
		mask-image: radial-gradient(ellipse 88% 82% at 82% 14%, #000 0%, rgb(0 0 0 / 78%) 43%, transparent 78%);
	}

	@media (max-width: 700px) {
		.ascii-field {
			opacity: 0.25;
			-webkit-mask-image: linear-gradient(to bottom, #000, transparent 68%);
			mask-image: linear-gradient(to bottom, #000, transparent 68%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ascii-field { opacity: 0.2; }
	}
</style>
